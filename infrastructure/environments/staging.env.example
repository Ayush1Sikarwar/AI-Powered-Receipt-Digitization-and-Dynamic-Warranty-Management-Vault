# ============================================================================
# WarrantyVault AI — STAGING environment template (TSD §51/§52).
#
# Copy to `.env.staging` at the repo root (it is git-ignored) and fill in
# every value. Staging is a full production-equivalent stack (same
# docker-compose.prod.yml, same boot guards) on SEPARATE infrastructure:
# separate domain, database, Redis, object storage, and secrets.
#
#   NEVER commit the filled-in file. NEVER reuse development credentials.
#   Staging secrets must also be unique — do not copy production values.
#   Generate secrets with:  openssl rand -hex 32
# ============================================================================

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=https://staging.warrantyvault.example
FRONTEND_BASE_URL=https://staging.warrantyvault.example

# --- Database (staging cluster/instance; NOT the dev database, NOT production) ---
POSTGRES_USER=warranty_staging
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_hex_32__
POSTGRES_DB=warranty_vault_staging
DATABASE_URL=postgresql+psycopg://warranty_staging:__POSTGRES_PASSWORD__@postgres:5432/warranty_vault_staging

# --- Redis (staging instance; AOF + password) ---
REDIS_PASSWORD=__GENERATE_WITH_openssl_rand_hex_32__
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0
USE_REDIS=true

# --- Auth (32+ chars, unique per deployment) ---
AUTH_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limits ---
RL_LOGIN_PER_MIN=10
RL_PASSWORD_RESET_PER_HOUR=5
RL_UPLOAD_PER_HOUR=20
RL_API_PER_MIN=300

# --- Uploads ---
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
UPLOAD_PDF_MAX_PAGES=20

# --- Object storage (staging bucket; least-privilege scope) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=warranty-vault-staging
S3_REGION=us-east-1
S3_ACCESS_KEY=__S3_ACCESS_KEY_ID__
S3_SECRET_KEY=__S3_SECRET_ACCESS_KEY__
SIGNED_URL_TTL_SECONDS=300

# --- Email (staging SMTP account; never production credentials) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=staging-notifications@warrantyvault.example
SMTP_PASSWORD=__SMTP_APP_PASSWORD__
SMTP_FROM=staging-notifications@warrantyvault.example

# --- Operations: identical observability profile to production ---
METRICS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
HEALTH_CHECK_WORKER=true
TRUST_PROXY=true
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# --- AI pipeline ---
PIPELINE_VERSION=1.1.0
OCR_PRIMARY_ENGINE=tesseract
OCR_LANG=eng
CONFIDENCE_AUTO_ACCEPT=0.90
CONFIDENCE_USER_REVIEW=0.70

# --- Warranty / retention (SRS NFR-02) ---
REMINDER_DAYS=60,30,7
RETENTION_CLOSED_ACCOUNT_DAYS=90
RETENTION_AUDIT_MIN_DAYS=365
RETENTION_DELETED_DOCUMENT_DAYS=7
