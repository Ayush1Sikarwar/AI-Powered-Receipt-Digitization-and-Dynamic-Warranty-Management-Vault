# ============================================================================
# WarrantyVault AI — PRODUCTION environment template (TSD §51/§52).
#
# Copy to `.env.production` at the repo root (it is git-ignored) and fill in
# every value. `docker-compose.prod.yml` refuses to start if any ${VAR:?}
# is empty, and the app independently refuses to boot in production with a
# weak AUTH_SECRET, DEBUG on, or a development CORS origin.
#
#   NEVER commit the filled-in file. NEVER reuse development credentials.
#   Generate secrets with:  openssl rand -hex 32
# ============================================================================

# --- Application (env=production triggers all production boot guards) ---
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=https://warrantyvault.example
FRONTEND_BASE_URL=https://warrantyvault.example

# --- Database (dedicated production cluster; NOT the dev database) ---
# SCRAM-authenticated, least-privilege role. See infrastructure/postgres/.
POSTGRES_USER=warranty_prod
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_hex_32__
POSTGRES_DB=warranty_vault_prod
DATABASE_URL=postgresql+psycopg://warranty_prod:__POSTGRES_PASSWORD__@postgres:5432/warranty_vault_prod

# --- Redis (internal network only; AOF + password) ---
REDIS_PASSWORD=__GENERATE_WITH_openssl_rand_hex_32__
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0
USE_REDIS=true

# --- Auth (32+ chars, unique per deployment) ---
AUTH_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limits (per client IP; the reverse proxy must forward X-Forwarded-For) ---
RL_LOGIN_PER_MIN=10
RL_PASSWORD_RESET_PER_HOUR=5
RL_UPLOAD_PER_HOUR=20
RL_API_PER_MIN=300

# --- Uploads ---
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
UPLOAD_PDF_MAX_PAGES=20

# --- Object storage (S3-compatible; least-privilege IAM/policy scope) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=warranty-vault-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=__S3_ACCESS_KEY_ID__
S3_SECRET_KEY=__S3_SECRET_ACCESS_KEY__
# Signed URLs are short-lived; originals are never served publicly.
SIGNED_URL_TTL_SECONDS=300

# --- Email (SMTP; the log provider is dev-only) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=notifications@warrantyvault.example
SMTP_PASSWORD=__SMTP_APP_PASSWORD__
SMTP_FROM=notifications@warrantyvault.example

# --- Operations (TSD §40/§51): enable production observability ---
METRICS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
HEALTH_CHECK_WORKER=true
TRUST_PROXY=true
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# --- AI pipeline ---
PIPELINE_VERSION=1.1.0
OCR_PRIMARY_ENGINE=tesseract
OCR_LANG=eng
# PROVISIONAL until calibrated against the PRD dataset floor.
CONFIDENCE_AUTO_ACCEPT=0.90
CONFIDENCE_USER_REVIEW=0.70

# --- Warranty / retention (SRS NFR-02) ---
REMINDER_DAYS=60,30,7
RETENTION_CLOSED_ACCOUNT_DAYS=90
RETENTION_AUDIT_MIN_DAYS=365
RETENTION_DELETED_DOCUMENT_DAYS=7
