# WarrantyVault AI — environment configuration template.
# Copy to backend/.env (or export in the environment). NEVER commit real secrets.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://warranty:warranty_dev_pw@127.0.0.1:5432/warranty_vault

# --- Redis (rate limiting / signalling; falls back to in-memory when down) ---
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=true

# --- Auth (generate with: openssl rand -hex 32) ---
AUTH_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limits ---
RL_LOGIN_PER_MIN=10
RL_PASSWORD_RESET_PER_HOUR=5
RL_UPLOAD_PER_HOUR=20
RL_API_PER_MIN=300

# --- Uploads ---
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf
UPLOAD_PDF_MAX_PAGES=20

# --- Object storage: local (dev) or s3 (prod) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
# S3_ENDPOINT_URL=
# S3_BUCKET=warranty-vault
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Email: log (dev, writes to email_outbox) or smtp (configured) ---
EMAIL_PROVIDER=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourdomain.com

# --- AI pipeline ---
# 1.1.0: digit-aware product-name heuristic + model identity on extracted fields
PIPELINE_VERSION=1.1.0
OCR_PRIMARY_ENGINE=tesseract
OCR_LANG=eng
# Confidence thresholds are PROVISIONAL until calibrated (see docs/ai/evaluation.md)
CONFIDENCE_AUTO_ACCEPT=0.90
CONFIDENCE_USER_REVIEW=0.70

# --- Warranty / retention ---
REMINDER_DAYS=60,30,7
RETENTION_CLOSED_ACCOUNT_DAYS=90
RETENTION_AUDIT_MIN_DAYS=365
# Grace period between a user-requested document deletion and the hard purge
# by the CLEANUP worker (the open-claim hold is re-checked at purge time).
RETENTION_DELETED_DOCUMENT_DAYS=7
